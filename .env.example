# Dominio público para producción (DuckDNS)
DOMAIN=mi-grupo.duckdns.org

# Email de contacto para notificaciones de expiración de Let's Encrypt
CERTBOT_EMAIL=admin@example.com

# Tags e imágenes de contenedores en GitHub Container Registry (ghcr.io)
UI_IMAGE=ghcr.io/tp1-2-ingsis/printscript-ui:latest
SNIPPET_SERVICE_IMAGE=ghcr.io/tp1-2-ingsis/snippet-service:latest
LANGUAGE_SERVICE_IMAGE=ghcr.io/tp1-2-ingsis/language-service:latest
PERMISSION_SERVICE_IMAGE=ghcr.io/tp1-2-ingsis/permission-service:latest

# Credenciales de PostgreSQL
SNIPPETS_DB_USER=snippets
SNIPPETS_DB_PASSWORD=snippets
PERMISSIONS_DB_USER=postgres
PERMISSIONS_DB_PASSWORD=postgres
