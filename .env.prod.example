# Valores entre comillas simples: el deploy carga este archivo como shell (ver README).
# AMBIENTE PROD - Dominio público (DuckDNS: <grupo>-prod)
DOMAIN='grupo-prod.duckdns.org'

# Email de contacto para notificaciones de expiración de Let's Encrypt
CERTBOT_EMAIL='admin@example.com'

# Tags e imágenes de contenedores en GitHub Container Registry (ghcr.io)
# PROD usa el tag :latest (push a main)
UI_IMAGE='ghcr.io/tp1-2-ingsis/printscript-ui:latest'
SNIPPET_SERVICE_IMAGE='ghcr.io/tp1-2-ingsis/snippet-service:latest'
LANGUAGE_SERVICE_IMAGE='ghcr.io/tp1-2-ingsis/language-service:latest'
PERMISSION_SERVICE_IMAGE='ghcr.io/tp1-2-ingsis/permission-service:latest'
ASSETS_SERVICE_IMAGE='ghcr.io/tp1-2-ingsis/assets:latest'

# Credenciales de PostgreSQL
SNIPPETS_DB_USER='snippets'
SNIPPETS_DB_PASSWORD='snippets'
PERMISSIONS_DB_USER='postgres'
PERMISSIONS_DB_PASSWORD='postgres'
ASSETS_DB_USER='assets'
ASSETS_DB_PASSWORD='assets'

# New Relic APM (opcional; completar cuando se cuente con la Ingest License Key)
NEW_RELIC_LICENSE_KEY=

# Auth0 - snippet-service (validación del JWT)
# Issuer del tenant, con la barra final: https://TU-TENANT.us.auth0.com/
AUTH0_ISSUER_URI='https://tu-tenant.us.auth0.com/'
# Identifier de la API en Auth0 (APIs > tu API > Identifier)
AUTH0_AUDIENCE='https://snippet-searcher-api'
# (Cada ambiente puede tener su propio tenant/API/app en Auth0; completar con los valores de ESTE ambiente)

# Auth0 - permission-service (búsqueda de usuarios vía Management API)
# Dominio del tenant, sin https://
AUTH0_DOMAIN='tu-tenant.us.auth0.com'
# Client ID / Secret de una aplicación Machine-to-Machine con el permiso read:users
AUTH0_MGMT_CLIENT_ID='changeme'
AUTH0_MGMT_CLIENT_SECRET='changeme'

# Redis (streams de tareas async): usan REDIS_URL=redis://redis:6379 dentro de la red interna.
# No requiere variables; no se publica ningún puerto.

# Assets (contenido de los snippets en Blob Storage)
# PROD usa la cuenta REAL de Azure Storage (paso manual M7 del plan: crear el storage account).
# Connection string: Azure Portal > Storage account > Security + networking > Access keys.
# Debe ser la de la cuenta de prod; el servicio `azurite` del stack queda levantado pero sin uso.
AZURE_STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=changeme;AccountKey=changeme;EndpointSuffix=core.windows.net'
# Nombre del container. Assets lo crea si no existe; conviene crearlo antes (M7) con el mismo nombre.
AZURE_STORAGE_CONTAINER='snippets'
